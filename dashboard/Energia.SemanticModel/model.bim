        "partitions": [
          {
            "name": "HECHOS",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(\"localhost\", \"REC_ECBD_Energia\", [CreateNavigationProperties=false]),",
                "    Tabla = Origen{[Schema=\"dbo\",Item=\"HECHOS\"]}[Data]",
                "in",
                "    Tabla"
              ]
            }
          }
        ],
        "description": "Una simulación por fila. Predicciones solo en 192 casos de prueba. Cargas no aditivas: usar medias.",
        "measures": [
          {
            "name": "Simulaciones",
            "expression": "COUNTROWS(HECHOS)",
            "formatString": "#,0"
          },
          {
            "name": "Calefaccion media",
            "expression": "AVERAGE(HECHOS[Y1])",
            "formatString": "0.00"
          },
          {
            "name": "Refrigeracion media",
            "expression": "AVERAGE(HECHOS[Y2])",
            "formatString": "0.00"
          },
          {
            "name": "Geometrias",
            "expression": "DISTINCTCOUNT(HECHOS[id_geometria])",
            "formatString": "0"
          },
          {
            "name": "MAE calefaccion",
            "expression": "AVERAGE(HECHOS[error_absoluto_Y1])",
            "formatString": "0.000"
          },
          {
            "name": "MAE refrigeracion",
            "expression": "AVERAGE(HECHOS[error_absoluto_Y2])",
            "formatString": "0.000"
          },
          {
            "name": "Casos de prueba",
            "expression": "CALCULATE(COUNTROWS(HECHOS), HECHOS[id_conjunto]=2)",
            "formatString": "0"
          },
          {
            "name": "Accuracy prueba",
            "expression": "DIVIDE(COUNTROWS(FILTER(HECHOS, HECHOS[id_conjunto]=2 && HECHOS[clase_predicha]=RELATED(DimClase[clase]))), [Casos de prueba])",
            "formatString": "0.0%"
          },
          {
            "name": "F1 macro global",
            "expression": "CALCULATE(MAX(MetricasClasificacion[F1_macro]), MetricasClasificacion[modelo]=\"Logistica\")",
            "formatString": "0.000"
          },
          {
            "name": "Silhouette elegido",
            "expression": "MAX(EvaluacionClusters[silhouette])",
            "formatString": "0.000"
          },
          {
            "name": "Varianza dos PC",
            "expression": "CALCULATE(SUM(VarianzaPCA[varianza_explicada]), VarianzaPCA[componente] IN {\"PC1\", \"PC2\"})",
            "formatString": "0.0%"
          }
        ]
      },
